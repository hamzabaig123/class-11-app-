OPENAI_MODEL="google/gemini-2.0-flash-001"
OPENAI_VISION_MODEL="google/gemini-2.0-flash-001"

# Import limits (optional)
IMPORT_MAX_FILE_BYTES="25000000"
IMPORT_MAX_PDF_PAGES="30"
IMPORT_MAX_IMAGE_DIMENSION="2400"
